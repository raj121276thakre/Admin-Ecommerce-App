<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:padding="2dp"
    >

    <LinearLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/productTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Name"
            android:textStyle="bold"
            android:maxLines="2"
            android:layout_marginBottom="2dp"
            android:textSize="22sp"
            android:textColor="@color/black"
            />

        <TextView
            android:id="@+id/productQuantity"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity : 1"
            android:layout_marginBottom="2dp"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/black"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >



            <TextView
                android:id="@+id/productTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="total price : ₹900"

                android:layout_marginBottom="2dp"
                android:maxLines="1"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/green"
                />


            <TextView
                android:id="@+id/productPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="selling price : ₹1200"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="2dp"
                android:textStyle="bold"
                android:maxLines="1"
                android:textSize="18sp"
                android:textColor="@color/grayish_blue"
                />


        </LinearLayout>


        <TextView
            android:id="@+id/userIdMobNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mob no : 1234567890"
            android:layout_marginBottom="2dp"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/black"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:weightSum="2"
            >

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/yellow"
                android:textColor="@color/white"
                android:layout_marginRight="6dp"
                android:textAllCaps="false"
                android:text="Cancle"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/proceedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/yellow"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:layout_marginLeft="6dp"
                android:text="Dispatched"
                />

        </LinearLayout>

    </LinearLayout>



</com.google.android.material.card.MaterialCardView>