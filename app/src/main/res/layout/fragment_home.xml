<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".fragments.HomeFragment">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingHorizontal="10dp"
        android:background="@color/yellow"
        android:gravity="center_vertical"
        android:weightSum="5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">



        <ImageView
            android:id="@+id/menu_icon"
            android:layout_width="30dp"
            android:layout_height="20dp"
            android:layout_weight="0.3"
            android:contentDescription="Menu"
            />

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4.28"
            android:text="@string/app_name"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:textAlignment="center"
            android:paddingStart="12dp"
          />


        <ImageView
            android:id="@+id/bell_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_weight="0.3"
            android:contentDescription="Notifications"
            />


    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sliderLayout"
        android:layout_margin="16dp"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:cardCornerRadius="10dp">

        <ImageView
            android:id="@+id/SliderImage"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:scaleType="fitXY"
            />

    </com.google.android.material.card.MaterialCardView>


    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/buttons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:paddingStart="17dp"
        android:layout_marginTop="16dp"
        app:alignmentMode="alignMargins"
        app:columnCount="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sliderLayout"
        app:rowCount="2">

        <!--Add Category-->
        <androidx.cardview.widget.CardView
            android:layout_width="160dp"
            android:layout_height="180dp"
            android:layout_margin="12dp"
            android:id="@+id/gotoAddCategory"
            android:orientation="vertical"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/item_background"
                android:gravity="center"
                android:padding="16dp">

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Add \nCategory"
                    android:textAlignment="center"
                    android:textColor="#006400"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>


        </androidx.cardview.widget.CardView>

        <!--Add Products-->
        <androidx.cardview.widget.CardView
            android:id="@+id/gotoAddProducts"
            android:layout_width="160dp"
            android:layout_height="180dp"
            android:layout_margin="12dp"
            android:orientation="vertical"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/item_background"
                android:gravity="center"
                android:padding="16dp">

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Add \nProducts"
                    android:textAlignment="center"
                    android:textColor="#800080"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>


        </androidx.cardview.widget.CardView>

        <!--Add Slider Image-->
        <androidx.cardview.widget.CardView
            android:id="@+id/gotoAddSlider"
            android:layout_width="160dp"
            android:layout_height="180dp"
            android:layout_margin="12dp"
            android:orientation="vertical"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/item_background"
                android:gravity="center"
                android:padding="16dp">

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Update Slider Image"
                    android:textAlignment="center"
                    android:textColor="#333333"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>


        </androidx.cardview.widget.CardView>

        <!--All Orders-->
        <androidx.cardview.widget.CardView
            android:layout_width="160dp"
            android:layout_height="180dp"
            android:layout_margin="12dp"
            android:id="@+id/gotoAllOrders"
            android:orientation="vertical"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/item_background"
                android:gravity="center"
                android:padding="16dp">

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="All \nOrders"
                    android:textAlignment="center"
                    android:textColor="#000080"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>


        </androidx.cardview.widget.CardView>


    </androidx.gridlayout.widget.GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
